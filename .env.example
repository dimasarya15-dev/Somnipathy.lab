# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File ".env" TIDAK boleh di-commit ke git.

# --- Flask ---
# Buat string acak, misalnya: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=1

# --- Database (MySQL / MariaDB dari XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=somnipathy_lab

# --- Machine Learning ---
# Folder tempat model_pipeline.pkl dan model_meta.json disimpan
MODEL_DIR=ml/artifacts
# Ambang batas keyakinan model (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.55

# --- Sistem rekomendasi ---
RULES_PATH=rules/recommendation_rules.json

# --- Lain-lain ---
# 1 = buat tabel otomatis saat aplikasi start (nyaman untuk pengembangan)
AUTO_CREATE_TABLES=1
